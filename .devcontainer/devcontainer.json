{
  "name": "Tag Management System Development",
  "dockerComposeFile": "../docker-compose.yml",
  "service": "dev",
  "init": false,
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",
  "features": {
    "ghcr.io/devcontainers/features/python:1": {
      "version": "3.12"
    },
    "ghcr.io/devcontainers/features/go:latest": {},
    "ghcr.io/devcontainers/features/node:1": {
      "version": "20"
    },
    "ghcr.io/devcontainers/features/git:1": {},
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {},
    "ghcr.io/devcontainers-community/npm-features/prettier:1": {},
    "ghcr.io/va-h/devcontainers-features/uv:1": {}
  },
  "runServices": ["postgres_db", "pgadmin", "backend", "frontend"],
  "remoteUser": "vscode",
  "customizations": {
    "vscode": {
      "extensions": [
        "esbenp.prettier-vscode",
        "golang.go",
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ms-azuretools.vscode-docker",
        "ms-python.black-formatter",
        "DavidAnson.vscode-markdownlint",
        "kilocode.kilo-code"
      ],
      "settings": {
        "python.defaultInterpreterPath": "./.venv/bin/python",
        "python.analysis.autoImportCompletions": true,
        "python.analysis.typeCheckingMode": "basic",
        "editor.defaultFormatter": "ms-python.black-formatter",
        "editor.formatOnSave": true,
        "chat.commandCenter.enabled": false,
        "workbench.tree.indent": 28,
        "workbench.tree.renderIndentGuides": "always",
        "explorer.confirmDragAndDrop": true,
        "explorer.confirmDelete": true,
        "files.exclude": {
          "**/__pycache__": true,
          "**/.pytest_cache": true,
          "**/.venv": true,
          "**/node_modules": true
        }
      }
    }
  },
  "remoteEnv": {
    "DATABASE_URL": "postgresql://app:app@db:5432/app"
  },
  "forwardPorts": [8080, 5175, 5432, 5050],
  "portsAttributes": {
    "8080": { "label": "Go Backend" },
    "5175": { "label": "Vite Frontend" },
    "5432": { "label": "Postgres" },
    "5050": { "label": "PGAdmin" }
  },
  "mounts": [
    "type=cache,target=/home/vscode/.cache/pip",
    "type=cache,target=/home/vscode/.cache/npm",
    "source=${localEnv:HOME}/.gitconfig,target=/home/vscode/.gitconfig,type=bind",
    "source=${localEnv:HOME}/.ssh,target=/home/vscode/.ssh,type=bind"
  ],
  "overrideCommand": false,
  "initializeCommand": "bash -lc 'test -f \"$HOME/.gitconfig\" || touch \"$HOME/.gitconfig\" && mkdir -p \"$HOME/.ssh\"'"
}
