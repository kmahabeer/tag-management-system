# Development Dockerfile for Frontend
FROM node:24

# Install security updates and development tools
RUN apt update && apt upgrade -y && apt install -y --no-install-recommends git

# Create non-root user
RUN addgroup --gid 1001 appgroup && adduser --uid 1001 --gid 1001 --disabled-password --gecos "" appuser

USER appuser

# Expose port
EXPOSE 5175

# Use dumb-init and start dev server
CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0"]