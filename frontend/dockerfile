# Base Dockerfile for Frontend
FROM node:24 AS builder

# Install security updates
RUN apt update && apt upgrade -y && apt install -y --no-install-recommends git

WORKDIR /app

# Copy package files
COPY package*.json ./

# Install dependencies
RUN npm ci

# Copy source code
COPY . .

# Build the application
RUN npm run build

# Create non-root user
RUN addgroup --gid 1001 appgroup && adduser --uid 1001 --gid 1001 --disabled-password --gecos "" appuser

USER appuser

# Expose port
EXPOSE 5175

# Use and start dev server
CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0"]