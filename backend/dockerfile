# Base Dockerfile for Backend
FROM golang:1.25 AS builder

# Install security updates and build tools
RUN apt update && apt upgrade && apt install -y --no-install-recommends git ca-certificates && rm -rf /var/lib/apt/lists/*

# Create app directory
WORKDIR /app

# Copy go mod files
COPY go.mod go.sum ./

# Download dependencies
RUN go mod download

# Copy source code
COPY . .

# Create non-root user
RUN addgroup --gid 1001 appgroup && adduser --uid 1001 --gid 1001 --disabled-password --gecos "" appuser

USER appuser

# Expose port
EXPOSE 8080

# Run the server
CMD ["./server"]